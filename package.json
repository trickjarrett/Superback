{
  "name": "super-back",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.js",
    "build": "node scripts/build.js",
    "lint": "web-ext lint --source-dir extension --warnings-as-errors",
