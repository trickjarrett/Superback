    "test:browser": "node scripts/test-browser.js"
  },
  "dependencies": { "tldts": "^7.0.0" },
  "devDependencies": { "esbuild": "^0.25.0", "web-ext": "^8.0.0", "playwright": "^1.55.0" }
}
